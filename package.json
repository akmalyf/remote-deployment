      },
      {
        "command": "deploy.setPassword",
        "title": "Set Password / Passphrase…",
        "category": "Deployment"
      },
      {
        "command": "deploy.forgetPassword",
        "title": "Forget Saved Password…",
        "category": "Deployment"
      },
      {
        "command": "deploy.disconnectAll",
        "title": "Disconnect All Servers",
        "category": "Deployment"
      },
      {
        "command": "deploy.remote.uploadCurrent",
        "title": "Upload Current Remote File",
        "category": "Deployment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deploy.remote.refreshCurrent",
        "title": "Refresh Current Remote File",
        "category": "Deployment",
        "icon": "$(refresh)"
      },
      {
        "command": "deploy.remote.compareLastUploaded",
        "title": "Compare with Last Uploaded Version",
        "category": "Deployment",
        "icon": "$(diff)"
      },
      {
        "command": "deploy.remote.revertLastUploaded",
        "title": "Revert to Last Uploaded Version",
        "category": "Deployment",
        "icon": "$(discard)"
      },
      {
        "command": "deploy.host.refresh",
        "title": "Refresh",
        "category": "Remote Host",
        "icon": "$(refresh)"
      },
      {
        "command": "deploy.host.collapse",
        "title": "Collapse All",
        "category": "Remote Host",
        "icon": "$(collapse-all)"
      },
      {
        "command": "deploy.host.goTo",
        "title": "Go to Path…",
        "category": "Remote Host",
        "icon": "$(go-to-file)"
      },
      {
        "command": "deploy.host.toggleSize",
        "title": "Show Size",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.newFile",
        "title": "File",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.newFolder",
        "title": "Directory",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.rename",
        "title": "Rename…",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.delete",
        "title": "Delete",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.cut",
        "title": "Cut",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.copy",
        "title": "Copy",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.paste",
        "title": "Paste",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.chmod",
        "title": "Change Permissions…",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.copyPaths",
        "title": "Copy Paths",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.copyWebUrl",
        "title": "Copy Web URL",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.toggleExclusion",
        "title": "Toggle Excluded Path",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.editLocal",
        "title": "Edit Local File",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.editRemote",
        "title": "Edit Remote File",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.download",
        "title": "Download from Here",
        "category": "Remote Host",
        "icon": "$(cloud-download)"
      },
      {
        "command": "deploy.host.upload",
        "title": "Upload Here",
        "category": "Remote Host",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deploy.host.compare",
        "title": "Compare with Local Version",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.sync",
        "title": "Sync with Local…",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.openInBrowser",
        "title": "Open in Browser",
        "category": "Remote Host"
      },
      {
        "command": "deploy.host.ssh",
        "title": "Start SSH Session",
        "category": "Remote Host",
        "icon": "$(terminal)"
      },
      {
        "command": "deploy.host.test",
        "title": "Test Connection",
        "category": "Remote Host",
        "icon": "$(plug)"
      },
      {
        "command": "deploy.host.setDefault",
        "title": "Use as Default Server",
