        "category": "Deployment",
        "icon": "$(globe)"
      },
      {
        "command": "deploy.toggleLocalExclusion",
        "title": "Toggle Excluded Path",
        "category": "Deployment"
      },
      {
        "command": "deploy.selectInRemoteHost",
