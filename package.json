    "keybindings": [
      {
        "command": "deploy.uploadTo",
        "key": "ctrl+shift+alt+x",
        "mac": "cmd+shift+alt+x"
      },
      {
        "command": "deploy.remote.uploadCurrent",
        "key": "shift+alt+q",
        "when": "resourceScheme == deploy-remote"
      },
      {
        "command": "deploy.host.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.rename",
        "key": "shift+f6",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.editLocal",
        "key": "f4",
        "when": "focusedView == deploy.remoteHost"
      },
      {
        "command": "deploy.host.copyPaths",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "focusedView == deploy.remoteHost"
      }
    ],
    "menus": {
      "deploy.submenu": [
        {
          "command": "deploy.upload",
          "group": "1_transfer@1",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.download",
          "group": "1_transfer@2",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.compare",
          "group": "2_compare@1",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.sync",
          "group": "2_compare@2",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.editRemoteFile",
          "group": "3_remote@1",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.configuration",
          "group": "9_config@1",
          "when": "!deploy.hasServers"
        }
      ],
      "explorer/context": [
        {
          "submenu": "deploy.submenu",
          "group": "deploy@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "submenu": "deploy.submenu",
          "group": "deploy@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "deploy.remote.uploadCurrent",
          "group": "deploy@1",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.refreshCurrent",
          "group": "deploy@2",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.compareLastUploaded",
          "group": "deploy@3",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.revertLastUploaded",
          "group": "deploy@4",
          "when": "resourceScheme == deploy-remote"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "deploy.submenu",
          "group": "deploy@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title": [
        {
          "command": "deploy.remote.uploadCurrent",
          "group": "navigation@1",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.refreshCurrent",
          "group": "navigation@2",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.compareLastUploaded",
          "group": "navigation@3",
          "when": "resourceScheme == deploy-remote"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "deploy.upload",
          "group": "deploy@1",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.compare",
          "group": "deploy@2",
          "when": "deploy.hasServers"
        },
        {
          "command": "deploy.sync",
          "group": "deploy@3",
          "when": "deploy.hasServers"
        }
      ],
      "view/title": [
        {
          "command": "deploy.host.refresh",
          "when": "view == deploy.remoteHost",
          "group": "navigation@1"
        },
        {
          "command": "deploy.host.goTo",
          "when": "view == deploy.remoteHost",
          "group": "navigation@2"
        },
        {
          "command": "deploy.configuration",
          "when": "view == deploy.remoteHost",
          "group": "navigation@3"
        },
        {
          "command": "deploy.host.collapse",
          "when": "view == deploy.remoteHost",
          "group": "navigation@4"
        },
        {
          "command": "deploy.host.toggleSize",
          "when": "view == deploy.remoteHost",
          "group": "1_view@1"
        },
        {
          "command": "deploy.selectDefaultServer",
          "when": "view == deploy.remoteHost",
          "group": "1_view@2"
        },
        {
          "command": "deploy.toggleAutoUpload",
          "when": "view == deploy.remoteHost",
          "group": "1_view@3"
        },
        {
          "command": "deploy.options",
          "when": "view == deploy.remoteHost",
          "group": "1_view@4"
        },
        {
          "command": "deploy.disconnectAll",
          "when": "view == deploy.remoteHost",
          "group": "1_view@5"
        },
        {
          "command": "deploy.log.output",
          "when": "view == deploy.fileTransfer",
          "group": "navigation@1"
        },
        {
          "command": "deploy.log.clear",
          "when": "view == deploy.fileTransfer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "deploy.host.serverMenu",
          "when": "view == deploy.remoteHost && viewItem =~ /^server/",
          "group": "inline@1"
        },
        {
          "command": "deploy.host.test",
          "when": "view == deploy.remoteHost && viewItem =~ /^server/",
          "group": "1_server@1"
        },
        {
          "command": "deploy.host.ssh",
          "when": "view == deploy.remoteHost && viewItem =~ /^server.*ssh/",
          "group": "1_server@2"
        },
        {
          "command": "deploy.host.setDefault",
          "when": "view == deploy.remoteHost && viewItem =~ /^server/",
          "group": "1_server@3"
        },
        {
          "command": "deploy.host.edit",
          "when": "view == deploy.remoteHost && viewItem =~ /^server/",
          "group": "1_server@4"
        },
        {
          "command": "deploy.host.disconnect",
          "when": "view == deploy.remoteHost && viewItem =~ /^server/",
          "group": "1_server@5"
        },
        {
          "command": "deploy.host.upload",
          "when": "view == deploy.remoteHost && viewItem =~ /^(remote|server)/",
          "group": "1_transfer@1"
        },
        {
          "command": "deploy.host.download",
          "when": "view == deploy.remoteHost && viewItem =~ /^(remote|server)/",
          "group": "1_transfer@2"
        },
        {
          "submenu": "deploy.remote.newSubmenu",
          "when": "view == deploy.remoteHost && viewItem =~ /^(remoteDir|server)/",
          "group": "2_edit@1"
        },
        {
          "command": "deploy.host.chmod",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote.*chmod/",
          "group": "2_edit@2"
        },
        {
          "command": "deploy.host.rename",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "2_edit@3"
        },
        {
          "command": "deploy.host.delete",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "2_edit@4"
        },
        {
          "command": "deploy.host.cut",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "3_clip@1"
        },
        {
          "command": "deploy.host.copy",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "3_clip@2"
        },
        {
          "command": "deploy.host.paste",
          "when": "view == deploy.remoteHost && viewItem =~ /^(remoteDir|server)/",
          "group": "3_clip@3"
        },
        {
          "command": "deploy.host.editLocal",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote.*mapped/",
          "group": "4_open@1"
        },
        {
          "command": "deploy.host.editRemote",
          "when": "view == deploy.remoteHost && viewItem =~ /^remoteFile/",
          "group": "4_open@2"
        },
        {
          "command": "deploy.host.openInBrowser",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote.*mapped/",
          "group": "4_open@3"
        },
        {
          "command": "deploy.host.sync",
          "when": "view == deploy.remoteHost && viewItem =~ /^(remote.*mapped|server)/",
          "group": "5_compare@1"
        },
        {
          "command": "deploy.host.compare",
          "when": "view == deploy.remoteHost && viewItem =~ /^remoteFile.*mapped/",
          "group": "5_compare@2"
        },
        {
          "command": "deploy.host.copyPaths",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "6_misc@1"
        },
        {
          "command": "deploy.host.copyWebUrl",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote.*mapped/",
          "group": "6_misc@2"
        },
        {
          "command": "deploy.host.toggleExclusion",
          "when": "view == deploy.remoteHost && viewItem =~ /^remote/",
          "group": "6_misc@3"
        },
        {
          "command": "deploy.log.details",
          "when": "view == deploy.fileTransfer && viewItem == transfer",
          "group": "1@1"
        }
      ],
      "deploy.remote.newSubmenu": [
        {
          "command": "deploy.host.newFile",
          "group": "1@1"
        },
        {
          "command": "deploy.host.newFolder",
          "group": "1@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deploy.remote.uploadCurrent",
          "when": "resourceScheme == deploy-remote"
        },
        {
          "command": "deploy.remote.refreshCurrent",
          "when": "resourceScheme == deploy-remote"
