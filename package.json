        {
          "command": "deploy.log.details",
          "when": "false"
        },
        {
          "command": "deploy.host.open",
          "when": "false"
        },
        {
          "command": "deploy.host.serverMenu",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "deployment",
        "required": [],
        "properties": {
          "server": {
            "type": "string",
            "description": "Server or group name. Defaults to the default server."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Local paths (relative to the workspace folder) to upload. Defaults to every mapped path."
          },
          "direction": {
            "type": "string",
            "enum": [
              "upload",
              "download"
            ],
            "default": "upload"
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/deployment.json",
        "url": "./schema/deployment.schema.json"
      }
    ],
    "configuration": {
      "title": "Remote Deployment",
      "properties": {
        "remoteDeployment.connectionIdleTimeout": {
          "type": "number",
          "default": 300,
          "description": "Seconds an idle connection stays open before it is closed."
        },
        "remoteDeployment.remoteEdit.uploadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Upload remote files opened with Edit Remote File when they are saved. When off, use Upload Current Remote File (Shift+Alt+Q)."
        }
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "deploy-remote",
        "formatting": {
          "label": "${authority}:${path}",
          "separator": "/",
          "workspaceSuffix": "Remote"
        }
      }
    ]
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('dist/media',{recursive:true});for(const f of ['codicon.css','codicon.ttf'])fs.copyFileSync('node_modules/@vscode/codicons/dist/'+f,'dist/media/'+f)\" && npm run build:webview && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:cpu-features --external:*.node --outfile=dist/extension.js --minify --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies",
    "build:webview": "esbuild src/webview/sync.ts --bundle --format=iife --target=chrome120 --minify --loader:.ttf=file --outfile=dist/media/sync.js && esbuild src/webview/settings.ts --bundle --format=iife --target=chrome120 --minify --outfile=dist/media/settings.js && esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --format=iife --target=chrome120 --minify --outfile=dist/media/editor.worker.js",
    "test": "esbuild test/smoke.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --external:cpu-features --external:*.node --outfile=dist-test/smoke.js --log-level=warning && node dist-test/smoke.js"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2": "^1.17.0",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.140.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Akmal"
  },
