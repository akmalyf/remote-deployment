{
  "name": "remote-deployment",
  "displayName": "Remote Deployment",
  "description": "Deploy to SFTP, FTP, FTPS, WebDAV and local folders: remote host browser, upload/download, compare and sync with a built-in diff, automatic upload, remote editing and SSH terminal.",
  "version": "1.0.0",
  "publisher": "akmalyf",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "webdav",
    "deploy",
    "deployment",
    "upload",
    "sync",
    "remote",
    "ssh",
    "rsync",
    "server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:deploy-remote",
    "workspaceContains:.vscode/deployment.json",
    "workspaceContains:.idea/deployment.xml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deployment",
          "title": "Deployment",
          "icon": "resources/deployment.svg"
        }
      ],
      "panel": [
        {
          "id": "deploymentPanel",
          "title": "File Transfer",
          "icon": "$(arrow-swap)"
        }
      ]
    },
    "views": {
      "deployment": [
        {
          "id": "deploy.remoteHost",
          "name": "Remote Host",
          "icon": "$(server)"
        }
      ],
      "deploymentPanel": [
        {
          "id": "deploy.fileTransfer",
          "name": "File Transfer",
          "icon": "$(arrow-swap)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deploy.remoteHost",
        "contents": "No deployment servers configured.\n[Add Server](command:deploy.configuration)\n[Import .idea Configuration](command:deploy.importIdea)\n[New Project from Existing Files…](command:deploy.newProjectFromServer)"
      },
      {
        "view": "deploy.fileTransfer",
        "contents": "No file transfers yet."
      }
    ],
    "submenus": [
      {
        "id": "deploy.submenu",
        "label": "Deployment",
        "icon": "$(cloud-upload)"
      },
      {
        "id": "deploy.remote.newSubmenu",
        "label": "New"
      }
    ],
    "commands": [
      {
        "command": "deploy.upload",
        "title": "Upload to Default Server",
        "category": "Deployment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deploy.uploadTo",
        "title": "Upload To…",
        "category": "Deployment"
      },
      {
        "command": "deploy.uploadAllOpen",
        "title": "Upload All Open Files to Default Server",
        "category": "Deployment"
      },
      {
        "command": "deploy.uploadAllOpenTo",
        "title": "Upload All Open Files To…",
        "category": "Deployment"
      },
      {
        "command": "deploy.download",
        "title": "Download from Default Server",
        "category": "Deployment",
        "icon": "$(cloud-download)"
      },
      {
        "command": "deploy.downloadFrom",
        "title": "Download From…",
        "category": "Deployment"
      },
      {
        "command": "deploy.compare",
        "title": "Compare with Deployed Version",
        "category": "Deployment",
        "icon": "$(diff)"
      },
      {
        "command": "deploy.compareWith",
        "title": "Compare with Deployed To…",
        "category": "Deployment"
      },
      {
        "command": "deploy.sync",
        "title": "Sync with Deployed…",
        "category": "Deployment",
        "icon": "$(sync)"
      },
      {
        "command": "deploy.syncWith",
        "title": "Sync with Deployed To…",
        "category": "Deployment"
      },
      {
        "command": "deploy.editRemoteFile",
        "title": "Edit Remote File",
        "category": "Deployment"
      },
      {
        "command": "deploy.deleteRemote",
