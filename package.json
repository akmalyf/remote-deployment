        "category": "Deployment"
      },
      {
        "command": "deploy.browse",
        "title": "Browse Remote Host",
        "category": "Deployment",
        "icon": "$(server)"
      },
      {
        "command": "deploy.selectDefaultServer",
        "title": "Choose Default Server or Group…",
        "category": "Deployment"
      },
      {
        "command": "deploy.testConnection",
        "title": "Test Connection…",
        "category": "Deployment",
        "icon": "$(plug)"
      },
      {
        "command": "deploy.startSsh",
